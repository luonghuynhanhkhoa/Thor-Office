# Sao chép thành .env.local rồi điền (file .env.local KHÔNG được đưa lên git).

# (Tuỳ chọn) Nối AI thật bằng Claude API. Để trống = dùng Claude Code (nếu máy có lệnh `claude`) hoặc chế độ tự tính.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5

# (Tuỳ chọn) Ép chế độ chạy: api | cli | sim
# AI_RUNNER=sim

# (Tuỳ chọn) Đường dẫn tới .env.local của Thor để đọc dữ liệu. Mặc định ../Thor/.env.local
# THOR_ENV_PATH=C:\Users\SsS\Desktop\M\Thor\.env.local
